# Supabase project credentials. Keep the server-side secret key private.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SECRET_KEY

# Model priority used with each signed-in user's own Gemini API key.
# Confirm these model IDs are available to your Google AI project and support Search grounding.
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_SECONDARY=gemini-3.6-flash
GEMINI_MODEL_TERTIARY=gemini-3.5-flash

# Frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8001

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GEMINI_KEY_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
