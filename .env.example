# Supabase Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Server-only Supabase secret for the Express API. Never expose this to Vite/browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SECRET_KEY


# Browser-safe publishable key (starts with sb_publishable_). This is not a secret.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server port
PORT=8000
NODE_ENV=development

# V2 Python AI service URL. In local development the FastAPI backend runs on port 8001.
VITE_AI_API_URL=http://localhost:8001

# Google OAuth is configured in Supabase Authentication → Providers → Google.
# Add http://localhost:5173 and your deployed CardVault URL to Supabase redirect URLs.
